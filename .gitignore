# Secretos y configuración local (nunca subir)
.env
.streamlit/secrets.toml

# Entornos y dependencias instaladas
.venv/
venv/
node_modules/

# Cachés de Python
__pycache__/
*.pyc

# Datos generados en tiempo de ejecución
