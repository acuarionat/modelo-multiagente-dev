# Copia este archivo a .streamlit/secrets.toml y completa los valores reales.
# .streamlit/secrets.toml NO debe subirse al repositorio (ya está en .gitignore).
#
# Pasos en Azure Portal (Microsoft Entra ID):
# 1. Microsoft Entra ID > Registros de aplicaciones > Nuevo registro.
#    - Tipos de cuenta admitidos: "Solo cuentas en este directorio organizativo"
#      (esto es lo que restringe el acceso únicamente a cuentas institucionales
#      del tenant de Microsoft 365; una cuenta personal o de otra organización
#      no podrá iniciar sesión).
#    - URI de redirección (tipo Web): http://localhost:8501/oauth2callback
#      Si despliegas la app, agrega también https://TU-DOMINIO/oauth2callback.
# 2. En la página "Overview" del registro copia:
#    - "Id. de aplicación (cliente)"  -> client_id
#    - "Id. de directorio (inquilino)" -> reemplaza TENANT_ID en server_metadata_url
# 3. "Certificados y secretos" > Nuevo secreto de cliente > copia el VALOR
#    (no el "Id. de secreto") -> client_secret.
# 4. Genera un cookie_secret aleatorio (una sola vez, y consérvalo estable):
#    python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REEMPLAZA_CON_UN_VALOR_ALEATORIO"
client_id = "faf57d65-bb5c-4886-906b-fcd07eead66b"
client_secret = "REEMPLAZA_CON_EL_CLIENT_SECRET"
server_metadata_url = "https://login.microsoftonline.com/REEMPLAZA_CON_EL_TENANT_ID/v2.0/.well-known/openid-configuration"
