# =====================================================================
# TraceDev - Modelo Multiagente
# Copiar este archivo como ".env" (en la raíz del proyecto) y completar
# los valores marcados como OBLIGATORIO. El archivo .env NO se sube al
# repositorio (está en .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# GitLab (valores por defecto del formulario "Configuración del proyecto").
# La URL, el proyecto y el token también pueden ingresarse desde la
# interfaz; lo ingresado allí se guarda en database/database.db.
# El token debe tener alcance "api".
# ---------------------------------------------------------------------
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# ---------------------------------------------------------------------
# Proveedores LLM por agente (configuración con la que opera el sistema)
#   Central y Evaluador (todas las etapas) -> NVIDIA NIM
#   Calidad y Seguridad (todas las etapas) -> Groq
# ---------------------------------------------------------------------
ENABLE_REMOTE_LLM=true
# false = si falta una API key o el proveedor remoto falla, se informa el
# error en lugar de recurrir a Ollama local.
ENABLE_LOCAL_FALLBACK=false

LLM_PROVIDER_CENTRAL=nvidia
LLM_PROVIDER_QUALITY=groq
LLM_PROVIDER_SECURITY=groq
LLM_PROVIDER_EVALUATOR=nvidia

# --- NVIDIA NIM (OBLIGATORIO: https://build.nvidia.com -> API Key) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_CENTRAL=nvidia/nemotron-3.5-lightning-30b-a3b
# Desactiva el "thinking" de los modelos de razonamiento (menor latencia,
# JSON directo). Poner en false solo si se cambia a un modelo que no
# acepte chat_template_kwargs.
NVIDIA_DISABLE_THINKING=true
NVIDIA_CENTRAL_MAX_COMPLETION_TOKENS=8192
NVIDIA_CENTRAL_TEMPERATURE=0.1
NVIDIA_CENTRAL_TOP_P=1
NVIDIA_LLM_TIMEOUT_SECONDS=400
NVIDIA_LLM_MAX_RETRIES=1
# Opcionales: modelo distinto para Central/Evaluador de Codificación
# (si no se definen, heredan NVIDIA_MODEL_CENTRAL).
# NVIDIA_MODEL_CODING_CENTRAL=
# NVIDIA_MODEL_CODING_EVALUATOR=

# --- Groq (OBLIGATORIO: https://console.groq.com -> API Keys) ---
GROQ_API_KEY=
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_MODEL_SECURITY=openai/gpt-oss-120b

# --- Parámetros de ejecución remota ---
REMOTE_LLM_TIMEOUT_SECONDS=120
REMOTE_LLM_MAX_RETRIES=1
REMOTE_QUALITY_MAX_COMPLETION_TOKENS=2500
REMOTE_SECURITY_MAX_COMPLETION_TOKENS=2600
REMOTE_REASONING_EFFORT=low
REMOTE_REASONING_FORMAT=hidden
REMOTE_QUALITY_BATCH_SIZE=1
REMOTE_SECURITY_BATCH_SIZE=1
# Pausa entre llamadas (respeta los límites del plan gratuito de Groq/NVIDIA)
REMOTE_INTER_CALL_DELAY_SECONDS=60
REMOTE_INTER_CALL_DELAY_SECONDS_NVIDIA=15

# --- Agente Central ---
CENTRAL_BATCH_SIZE=1
CENTRAL_MAX_TECHNICAL_RETRIES=1

# ---------------------------------------------------------------------
# Ollama local (solo se usa si ENABLE_REMOTE_LLM=false o como respaldo
# cuando ENABLE_LOCAL_FALLBACK=true).
# ---------------------------------------------------------------------
OLLAMA_MODEL=phi4-mini
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------
# Persistencia externa (PostgreSQL). Si se deja vacío se usa SQLite local
# en database/database.db. Formato:
# postgresql://usuario:contraseña@host:5432/base?sslmode=require
# ---------------------------------------------------------------------
DATABASE_URL=
